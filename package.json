{
  "name": "weft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Weft M0: policy-governed, cache-first agent harness",
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts",
    "demo": "node --experimental-strip-types src/cli.ts --demo",
    "demo:v1": "node --experimental-strip-types scripts/v1-demo.ts",
    "conformance:guard": "node --experimental-strip-types scripts/sandbox-conformance.ts --backend workspace-guard",
    "conformance:docker": "node --experimental-strip-types scripts/sandbox-conformance.ts --backend docker",
    "test": "node --test --test-isolation=none --experimental-strip-types tests/all.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
