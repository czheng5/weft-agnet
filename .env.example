# Weft local configuration. Copy to .env and fill only what you use.
# Model (OpenAI-compatible; cloud key or local server)
WEFT_MODEL_BASE_URL=https://api.deepseek.com/v1
WEFT_MODEL=deepseek-chat
WEFT_MODEL_API_KEY=
# Local model example:
# WEFT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# WEFT_MODEL=qwen2.5-coder

# MemoryHub
# WEFT_PG_URL=postgres://postgres:weft@127.0.0.1:55432/weft
# WEFT_MEMORY_URL=http://127.0.0.1:4780
# WEFT_MEMORY_TOKEN=

# Knowledge base
# WEFT_KB_URL=http://127.0.0.1:8080
# WEFT_KB_KIND=http
# WEFT_KB_TOKEN=

# Runtime
WEFT_GUARDIAN=rule
WEFT_PORT=4780
# WEFT_ENV=.env
